# Tavily API key (optional) — enables Tavily web search for agents.
# When set, web_search calls use Tavily; otherwise DuckDuckGo is used as fallback.
# Get your key at https://app.tavily.com
TAVILY_API_KEY=

# Inference provider
# AGENT_INFERENCE_PROVIDER=ollama
# AGENT_MODEL=llama3.2:latest

# Claude/OpenAI-compatible mode (recommended for faster high-quality execution)
# AGENT_INFERENCE_PROVIDER=claude
# CLAUDE_MODEL=claude-3-5-sonnet-latest
# CLAUDE_BASE_URL=https://openrouter.ai/api
# CLAUDE_API_KEY=

# Optional: directory containing server extension modules (.js/.cjs/.mjs/.ts).
# If unset, server falls back to built-in hooks in packages/server/src/extensions/builtin.
# AGENT_EXTENSION_DIR=packages/server/dist/extensions/builtin
